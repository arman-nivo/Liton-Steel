{
  "name": "liton-steel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lighthouse": "npx --yes @lhci/cli@0.14.x autorun",
    "build:share": "NEXT_DIST_DIR=.next-prod next build",
    "start:share": "NEXT_DIST_DIR=.next-prod next start -p 3100",
    "tunnel": "cloudflared tunnel --url http://localhost:3100",
    "backup": "node scripts/backup.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "framer-motion": "^13.4.0",
    "gsap": "^3.15.0",
    "immer": "^11.1.18",
    "jose": "^6.2.12",
    "lenis": "^1.3.26",
    "lucide-react": "^1.46.0",
    "nanoid": "^6.0.1",
    "next": "15.5.25",
    "nodemailer": "^10.0.10",
    "react": "19.1.0",
    "react-colorful": "^5.8.1",
    "react-dom": "19.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
